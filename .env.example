# ============================================
# BIRTHDAY REMINDER - ENVIRONMENT VARIABLES
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app-name.onrender.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/databasename?retryWrites=true&w=majority

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================
# SESSION CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_KEY=your-random-hex-string-here


# Email Configuration (Nodemailer)
# For Gmail: use your email and an App Password (not your regular password)
# Generate App Password: Google Account > Security > 2-Step Verification > App Passwords
# Email
SMTP_HOST=mail.gmail.com
SMTP_PORT=587
SMTP_USER=mail.com
SMTP_PASS=gggg qqqq qqqq wwww
